--- a/vendor/psx4all-dingoo-master/src/spmp_port/spmp_psx_jit_store.h
+++ b/vendor/psx4all-dingoo-master/src/spmp_port/spmp_psx_jit_store.h
@@ -0,0 +1,49 @@
+/* SPMP-OS PSX4ALL: one owned, cache-line-aligned allocation for ARM JIT data.
+ * This header intentionally avoids libc and C++ runtime dependencies.
+ * Allocation callbacks are supplied by SPMP-OS or the host test harness.
+ * Copyright 2026 SPMP-OS contributors; SPDX-License-Identifier: GPL-2.0-or-later.
+ */
+#ifndef SPMP_PSX_JIT_STORE_H
+#define SPMP_PSX_JIT_STORE_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define SPMP_PSX_JIT_RAM_BYTES (2u * 1024u * 1024u)
+#define SPMP_PSX_JIT_ROM_BYTES (512u * 1024u)
+#define SPMP_PSX_JIT_LUT_BYTES (65536u * sizeof(uint32_t))
+#define SPMP_PSX_JIT_ALIGNMENT 64u
+
+typedef void *(*spmp_psx_jit_alloc_fn)(size_t bytes, void *opaque);
+typedef void (*spmp_psx_jit_free_fn)(void *address, void *opaque);
+typedef struct spmp_psx_jit_store {
+    void *allocation;
+    uint8_t *code;
+    int8_t *ram;
+    int8_t *rom;
+    uint32_t *lut;
+    size_t bytes_owned;
+    size_t code_capacity;
+} spmp_psx_jit_store;
+
+/* Exported by ARM recompiler, not by this allocator module. HAL must call
+ * prepare, validate the returned executable region, then attach cache guard,
+ * before calling psxRec.Init. On failure call abort. */
+int spmp_psx_rec_prepare(spmp_psx_jit_alloc_fn alloc,
+    spmp_psx_jit_free_fn release, void *opaque,
+    uintptr_t *address, size_t *length);
+void spmp_psx_rec_abort(void);
+
+/* Capacity is 1-8 MiB, multiple of 1024 bytes. No partial success.
+ * Caller must provide an empty store (zero-filled struct) and must pair init
+ * with release using the SAME allocator context. This is not thread safe.
+ */
+int spmp_psx_jit_store_init(spmp_psx_jit_store *store, size_t capacity,
+                            spmp_psx_jit_alloc_fn alloc, void *opaque);
+void spmp_psx_jit_store_release(spmp_psx_jit_store *store,
+                                spmp_psx_jit_free_fn release, void *opaque);
+#ifdef __cplusplus
+}
+#endif
+#endif
--- a/vendor/psx4all-dingoo-master/src/spmp_port/spmp_psx_jit_store.c
+++ b/vendor/psx4all-dingoo-master/src/spmp_port/spmp_psx_jit_store.c
@@ -0,0 +1,44 @@
+#include "spmp_psx_jit_store.h"
+#include <string.h>
+#include <stdint.h>
+#include <stddef.h>
+
+static uintptr_t aligned_up(uintptr_t value, uintptr_t align) {
+    return (value + align - 1u) & ~(align - 1u);
+}
+int spmp_psx_jit_store_init(spmp_psx_jit_store *store, size_t capacity,
+                            spmp_psx_jit_alloc_fn alloc, void *opaque) {
+    size_t length;
+    uint8_t *p;
+    void *allocation;
+    if (!store || !alloc || store->allocation || store->code || store->lut ||
+        store->ram || store->rom || store->bytes_owned ||
+        capacity < 1024u*1024u || capacity > 8u*1024u*1024u ||
+        (capacity & 1023u)) return 0;
+    /* Include alignment slack for the returned allocation. */
+    if (capacity > SIZE_MAX - SPMP_PSX_JIT_RAM_BYTES - SPMP_PSX_JIT_ROM_BYTES -
+                   SPMP_PSX_JIT_LUT_BYTES - SPMP_PSX_JIT_ALIGNMENT) return 0;
+    length = capacity + SPMP_PSX_JIT_RAM_BYTES + SPMP_PSX_JIT_ROM_BYTES +
+             SPMP_PSX_JIT_LUT_BYTES + SPMP_PSX_JIT_ALIGNMENT;
+    allocation = alloc(length, opaque);
+    if (!allocation) return 0;
+    if ((uintptr_t)allocation > UINTPTR_MAX - SPMP_PSX_JIT_ALIGNMENT) return 0;
+    p = (uint8_t *)aligned_up((uintptr_t)allocation, SPMP_PSX_JIT_ALIGNMENT);
+    /* Memory is private to this core: no allocations survive release. */
+    memset(p, 0, length - (size_t)(p - (uint8_t *)allocation));
+    store->allocation = allocation;
+    store->code = p;
+    store->ram = (int8_t *)(p + capacity);
+    store->rom = (int8_t *)(p + capacity + SPMP_PSX_JIT_RAM_BYTES);
+    store->lut = (uint32_t *)(void *)(p + capacity + SPMP_PSX_JIT_RAM_BYTES +
+                                     SPMP_PSX_JIT_ROM_BYTES);
+    store->bytes_owned = length;
+    store->code_capacity = capacity;
+    return 1;
+}
+void spmp_psx_jit_store_release(spmp_psx_jit_store *store,
+                                spmp_psx_jit_free_fn release, void *opaque) {
+    if (!store) return;
+    if (store->allocation && release) release(store->allocation, opaque);
+    memset(store, 0, sizeof(*store));
+}
--- a/tests/test_stage13.c
+++ b/tests/test_stage13.c
@@ -0,0 +1,68 @@
+#include "spmp_psx_jit_store.h"
+#include <stdlib.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+#include <assert.h>
+
+static size_t live_bytes;
+static unsigned allocations, releases;
+static int deny_next;
+static void *test_alloc(size_t n, void *opaque) {
+    (void)opaque;
+    if (deny_next) { deny_next=0; return NULL; }
+    void *p = malloc(n);
+    if (p) { ++allocations; live_bytes += n; }
+    return p;
+}
+static void test_free(void *p, void *opaque) {
+    (void)opaque;
+    ++releases;
+    /* length tested before calling release; do not use freed struct */
+    free(p);
+}
+static void test_one(size_t bytes) {
+    spmp_psx_jit_store s = {0};
+    assert(spmp_psx_jit_store_init(&s,bytes,test_alloc,NULL));
+    assert(s.code && s.ram && s.rom && s.lut);
+    assert(s.code_capacity == bytes);
+    assert(((uintptr_t)s.code & 63u) == 0u);
+    assert((uint8_t *)s.ram == s.code + bytes);
+    assert((uint8_t *)s.rom == (uint8_t *)s.ram + SPMP_PSX_JIT_RAM_BYTES);
+    assert((uint8_t *)s.lut == (uint8_t *)s.rom + SPMP_PSX_JIT_ROM_BYTES);
+    assert(s.code[0]==0 && s.code[bytes-1]==0);
+    assert(s.ram[SPMP_PSX_JIT_RAM_BYTES-1]==0);
+    assert(s.rom[SPMP_PSX_JIT_ROM_BYTES-1]==0);
+    assert(s.lut[65535]==0);
+    assert(!spmp_psx_jit_store_init(&s,bytes,test_alloc,NULL)); /* no double init */
+    s.code[0] = 0xea;
+    s.code[bytes-1] = 0xff;
+    s.ram[SPMP_PSX_JIT_RAM_BYTES-1] = 65;
+    s.rom[SPMP_PSX_JIT_ROM_BYTES-1] = 73;
+    s.lut[65535] = 0x12345678u;
+    size_t length = s.bytes_owned;
+    spmp_psx_jit_store_release(&s,test_free,NULL);
+    live_bytes -= length;
+    assert(!s.allocation && !s.code && !s.ram && !s.rom && !s.lut);
+    assert(!s.bytes_owned && !s.code_capacity);
+    spmp_psx_jit_store_release(&s,test_free,NULL); /* idempotent */
+}
+int main(void) {
+    spmp_psx_jit_store s={0};
+    assert(!spmp_psx_jit_store_init(NULL,1024u*1024u,test_alloc,NULL));
+    assert(!spmp_psx_jit_store_init(&s,0,test_alloc,NULL));
+    assert(!spmp_psx_jit_store_init(&s,1023u*1024u,test_alloc,NULL));
+    assert(!spmp_psx_jit_store_init(&s,8193u*1024u,test_alloc,NULL));
+    assert(!spmp_psx_jit_store_init(&s,1024u*1024u+1,test_alloc,NULL));
+    assert(!spmp_psx_jit_store_init(&s,1024u*1024u,NULL,NULL));
+    deny_next=1;
+    assert(!spmp_psx_jit_store_init(&s,1024u*1024u,test_alloc,NULL));
+    assert(!s.allocation && !s.code && !s.bytes_owned);
+    const size_t sizes[]={1024u*1024u,2048u*1024u,4096u*1024u,8192u*1024u};
+    for (unsigned cycle=0;cycle<250;cycle++) test_one(sizes[cycle%4]);
+    assert(live_bytes==0 && allocations==releases);
+    printf("Stage13 JIT arena: 250 lifecycle cycles, 4 capacity profiles, "
+           "invalid sizes/OOM/reinit/release PASS (allocs=%u frees=%u)\n",
+           allocations,releases);
+    return 0;
+}
